{
  "name": "suno-downloader-app",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "description": "Suno 歌曲下载器 - Capacitor + React + 原生插件",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/test_song_e2e.mjs",
    "test:lrc": "node scripts/test_lrc.mjs",
    "android": "node scripts/run_app.mjs",
    "build:apk": "node scripts/build_apk.mjs",
    "cap:sync": "cap sync android && node scripts/install_suno_auth_native.mjs",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.5.0",
    "browser-id3-writer": "^4.4.0",
    "fflate": "^0.8.3",
    "lamejs": "^1.2.1",
    "lucide-react": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
